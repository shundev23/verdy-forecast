<?xml version="1.0" encoding="utf-8"?>
<!--
  パッケージの取得元を nuget.org だけにする（security.md の A03 サプライチェーン対策）。
  PC 全体の設定にある取得元は <clear /> で使わない。パッケージソースマッピングで、すべてのパッケージを nuget.org に結び付ける。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
